                          browserAppInstance = (window.openWindows || {})[browserWindow.dataset.instanceId]?.appInstance;
                      }

                      if (browserAppInstance && typeof browserAppInstance.navigateTo === 'function') {
                          browserAppInstance.navigateTo(node.url);
                          if (window.focusWindow) window.focusWindow(browserWindow);
                      } else {
                          _createWindowFnRef(targetBrowserAppId, { navigateToUrl: node.url });
                      }
                  }
              }
              renderApp();
          }

          treeContainer.addEventListener('click', (event) => {
              const li = event.target.closest('li[data-id]');
              if (li) {
                  handleNodeInteraction(li.dataset.id, false); // Pass false for isDblClick
                   if (event.target.classList.contains('tree-toggler')) { // If toggler itself was clicked
                      event.stopPropagation(); // Prevent li click from re-toggling if logic changes
                  }
              }
          });
          treeContainer.addEventListener('dblclick', (event) => {
              const li = event.target.closest('li[data-id]');
              if (li) {
                  handleNodeInteraction(li.dataset.id, true); // Pass true for isDblClick
              }
          });

          const menus = {};
          windowEl.querySelectorAll('.menu-bar .menu-item[data-menu]').forEach(menuItem => {
              const menuKey = menuItem.dataset.menu;
              const dropdown = windowEl.querySelector(`.dropdown-menu.${menuKey}-menu`);
              if (dropdown) {
                  menus[menuKey] = { item: menuItem, dropdown: dropdown };
                  menuItem.addEventListener('click', (e) => {
                      e.stopPropagation();
                      const isVisible = dropdown.style.display === 'block';
                      // Hide all other dropdowns
                      Object.values(menus).forEach(m => {
                          if (m.dropdown !== dropdown) m.dropdown.style.display = 'none';
                      });
                      dropdown.style.display = isVisible ? 'none' : 'block';
                  });
              }
          });
          // Global click to close open menus
          const appContainer = windowEl.querySelector('.network-bookmarks-app');
          appContainer.addEventListener('click', (e) => {
              let clickedInsideMenu = false;
              Object.values(menus).forEach(m => {
                  if (m.item.contains(e.target) || m.dropdown.contains(e.target)) {
                      clickedInsideMenu = true;
                  }
              });
              if (!clickedInsideMenu) {
                  Object.values(menus).forEach(m => m.dropdown.style.display = 'none');
              }
          }, true);


          windowEl.querySelectorAll('.dropdown-item[data-action]').forEach(item => {
              item.addEventListener('click', (e) => {
                  if (item.classList.contains('disabled')) return;
                  e.stopPropagation();
                  const action = item.dataset.action;
                  const selectedNode = selectedNodeId ? bookmarks.find(b => b.id === selectedNodeId) : null;
                  Object.values(menus).forEach(m => m.dropdown.style.display = 'none'); // Close all menus

                  if (action === 'add') { openModal('add'); }
                  else if (action === 'edit') {
                      if (selectedNode && selectedNode.id !== ROOT_NODE_ID) openModal('edit', selectedNode);
                      else alert(selectedNode ? "Cannot edit the 'Entire Network' root." : "Select an item to edit.");
                  } else if (action === 'delete') {
                      if (selectedNode && selectedNode.id !== ROOT_NODE_ID) {
                          if (confirm(`Delete "${selectedNode.title}"? ${selectedNode.type === 'domain' ? 'This will delete all its contents.' : ''}`)) {
                              let idsToDelete = [selectedNodeId];
                              if (selectedNode.type === 'domain' || selectedNode.type === 'root') { // Should not be root here due to check
                                  const stack = bookmarks.filter(b => b.parentId === selectedNodeId).map(c => c.id);
                                  while(stack.length > 0) {
                                      const childId = stack.pop(); idsToDelete.push(childId);
                                      bookmarks.filter(b => b.parentId === childId).forEach(gc => stack.push(gc.id));
                                  }
                              }
                              bookmarks = bookmarks.filter(b => !idsToDelete.includes(b.id));
                              selectedNodeId = ROOT_NODE_ID; saveBookmarks(bookmarks); renderApp();
                          }
                      } else alert(selectedNode ? "Cannot delete the 'Entire Network' root." : "Select an item to delete.");
                  }
              });
          });

          function renderApp() {
              const treeData = buildTree(bookmarks, null);
              treeContainer.innerHTML = renderTreeRecursive(treeData, 0, selectedNodeId, {});
              const selectedNode = selectedNodeId ? bookmarks.find(b => b.id === selectedNodeId) : null;
              const canEditDelete = selectedNode && selectedNode.id !== ROOT_NODE_ID;

              const editMenuItem = windowEl.querySelector('.dropdown-item[data-action="edit"]');
              const deleteMenuItem = windowEl.querySelector('.dropdown-item[data-action="delete"]');
              if(editMenuItem) editMenuItem.classList.toggle('disabled', !canEditDelete);
              if(deleteMenuItem) deleteMenuItem.classList.toggle('disabled', !canEditDelete);
          }
          renderApp();
      }
  };
