<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Windows 98½</title>
    <link rel=icon href="https://win98icons.alexmeub.com/icons/png/internet_connection_wiz-0.png">
    <style>
        body {
            background-color: #008080; /* Classic Teal */
            font-family: "MS Sans Serif", "Tahoma", Arial, sans-serif;
            font-size: 12px;
            margin: 0;
            overflow: hidden;
            user-select: none;
        }

        .desktop {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 30px; /* Space for taskbar */
            padding: 10px;
            display: flex;
            flex-direction: column;
            flex-wrap: wrap;
            align-content: flex-start; /* Align icons to the left */
        }
        /* Add :focus style for desktop for visual feedback when it has keyboard focus */
        .desktop:focus {
            /* Example: subtle border to show it's the active container */
            /* outline: 1px dashed rgba(255, 255, 255, 0.3); */
            /* outline-offset: -1px; */
            /* Script handles .keyboard-focused on items, this is for the container itself */
        }


        .desktop-icon {
            width: 75px;
            margin: 10px;
            text-align: center;
            color: white;
            cursor: pointer;
            padding: 5px;
            /* Ensure icons don't get a default browser outline if script handles focus */
        }
        .desktop-icon:focus { 
            outline: none;
        }

        .desktop-icon:hover {
            background-color: rgba(0, 0, 128, 0.5); /* Dark blue transparent */
            outline: 1px dotted white;
        }
        .desktop-icon img {
            width: 32px;
            height: 32px;
            display: block;
            margin: 0 auto 5px auto;
        }
        .desktop-icon.selected {
            background-color: rgba(0, 0, 128, 0.7); /* Darker selection */
            outline: 1px dotted white;
        }
        .desktop-icon.selected span {
            background-color: #000080; /* Opaque background for text */
            color: white; /* Ensure text is visible */
            padding: 1px 2px;
        }


        .taskbar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 30px;
            background-color: #c0c0c0; /* Classic Gray */
            border-top: 2px solid #ffffff;
            display: flex;
            align-items: center;
            padding: 0 5px;
            z-index: 10000; /* Always on top */
        }

        .start-button {
            background-color: #c0c0c0;
            border: 2px outset #dfdfdf;
            padding: 2px 10px;
            margin-right: 5px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
        }
        .start-button:active {
            border-style: inset;
        }
        .start-button img {
            width: 16px;
            height: 16px;
            margin-right: 5px;
        }
        .start-button:focus { /* Style for when start button itself has focus */
            outline: 1px dotted black;
            outline-offset: -2px;
        }


        .start-menu {
            position: absolute;
            bottom: 30px; /* Above taskbar */
            left: 0;
            /* width: 200px; /* Slightly wider for icons (now auto) */
            background-color: #c0c0c0;
            border: 2px outset #dfdfdf;
            box-shadow: 2px 2px 5px rgba(0,0,0,0.3);
            /* padding: 2px; (now handled by items-container) */
            display: none; /* Hidden by default */
            z-index: 9999;
            flex-direction: row; /* Changed for sidebar layout */
            width: auto; 
        }
        .start-menu:focus { /* Style for when start menu container has focus */
            /* outline: 1px dotted blue; */ /* Example */
            outline: none; /* Script manages item focus visuals */
        }

        .start-menu-item {
            padding: 5px 10px 5px 5px; /* Adjusted padding */
            cursor: pointer;
            position: relative;
            display: flex;
            align-items: center;
        }
        .start-menu-item:hover {
            background-color: #000080; /* Dark Blue */
            color: white;
        }
        .start-menu-item:focus { /* Remove default outline if script handles visual focus */
            outline: none;
        }
        .start-menu-icon {
            width: 20px; /* Slightly larger for start menu */
            height: 20px;
            margin-right: 8px;
            vertical-align: middle;
        }
        .start-menu-separator {
            height: 1px;
            background-color: #808080;
            margin: 2px 0;
            border-bottom: 1px solid #ffffff;
        }
        .start-menu-item.disabled {
            color: #808080;
            cursor: default;
        }
        .start-menu-item.disabled:hover {
            background-color: #c0c0c0;
            color: #808080;
        }


        .start-menu-sidebar {
            background-color: #000080; /* Dark Blue */
            color: white;
            padding: 10px 5px;
            writing-mode: vertical-lr; /* Rotate text */
            text-orientation: mixed;
            transform: rotate(180deg); /* Correct orientation after vertical-rl */
            font-weight: bold;
            font-size: 16px; /* Adjust as needed */
            display: flex;
            align-items: center;
            justify-content: center;
            border-right: 2px outset #dfdfdf; /* 3D effect */
            min-width: 25px; /* Ensure it has some width */
        }
        .start-menu-sidebar .and-half {
          display: inline-block;
          transform:rotate(90deg);
        }
        .start-menu-sidebar-text {
            white-space: nowrap; /* Prevent text from wrapping */
        }

        .start-menu-items-container {
            background-color: #c0c0c0; /* Original start menu background */
            padding: 2px; /* Original start menu padding */
            width: 180px; /* Original width of items area, adjust if needed */
            display: flex;
            flex-direction: column;
        }

        .taskbar-windows {
            display: flex;
            flex-grow: 1;
            margin: 0 5px;
            overflow: hidden;
        }
        .taskbar-button {
            background-color: #c0c0c0;
            border: 2px outset #dfdfdf;
            padding: 1px 5px; /* Adjusted padding */
            margin-right: 3px;
            font-size: 11px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 150px;
            cursor: pointer;
            display: flex;
            align-items: center;
            height: 22px; /* Consistent height */
            box-sizing: border-box;
        }
        .taskbar-button:focus { /* Style for focused taskbar buttons */
            outline: 1px dotted black;
            outline-offset: -2px;
        }
        .taskbar-button.active {
            border-style: inset;
            font-weight: bold;
        }
        .taskbar-button img {
            width: 16px;
            height: 16px;
            margin-right: 4px;
            vertical-align: middle;
        }
        .taskbar-button.minimized {
            opacity: 0.9; /* Slightly different look for minimized */
        }


        .clock {
            border: 1px inset #808080;
            padding: 3px 8px;
            margin-left: auto; /* Pushes to the right */
            font-size: 11px;
            min-width: 60px;
            text-align: center;
            height: 20px; /* Consistent height */
            line-height: 12px; 
            box-sizing: border-box;
        }

        /* Window Styling */
        .window {
            position: absolute;
            background-color: #c0c0c0;
            border: 2px outset #dfdfdf;
            box-shadow: 2px 2px 5px rgba(0,0,0,0.5);
            min-width: 200px;
            min-height: 150px;
            display: flex;
            flex-direction: column;
            overflow: hidden; 
        }
        .window:focus, .window:focus-within { /* Indicate active window subtly */
             /* border-color: #666; */ /* Example: darker border for focused window */
             /* The .inactive class handles visual distinction well, so direct focus style might be redundant */
        }


        .window-titlebar {
            background-color: #000080; /* Dark Blue */
            color: white;
            padding: 3px 5px;
            font-weight: bold;
            cursor: grab;
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 20px; 
            box-sizing: border-box;
        }
        .window-titlebar:active {
            cursor: grabbing;
        }
        .window-titlebar-icon {
            margin-right: 5px;
            vertical-align: middle; 
            width: 16px;
            height: 16px;
        }
        .window-title {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            flex-grow: 1; 
        }
        .window.inactive .window-titlebar {
            background-color: #808080; 
        }
        .window.inactive .window-titlebar-icon {
            opacity: 0.7; 
        }
        .window.inactive .window-title {
            color: #D3D3D3; 
        }


        .window-controls button {
            background-color: #c0c0c0;
            border: 1px outset #dfdfdf;
            color: black;
            font-family: "Marlett", "Webdings"; 
            font-size: 10px; 
            width: 16px;
            height: 14px;
            line-height: 10px; 
            padding: 0;
            margin-left: 2px;
            cursor: pointer;
        }
        .window-controls button:active {
            border-style: inset;
        }
        .window-controls button:focus { /* Style for focused window control buttons */
            outline: 1px dotted black;
            outline-offset: -1px;
        }
        .window-controls {
          min-width: fit-content;
        }


        .window-content {
            padding: 0; 
            background-color: #ffffff; 
            flex-grow: 1;
            margin: 3px;
            border: 1px inset #808080;
            overflow: auto; 
            display: flex; 
            flex-direction: column; 
        }
        .window-content:focus { /* Style for when content area itself gets focus */
             /* outline: 1px solid blue; */ /* Example, if needed */
        }


        .window.maximized .window-titlebar {
            cursor: default; 
        }

        .win95-button {
            background-color: #c0c0c0;
            border: 2px outset #dfdfdf;
            padding: 5px 15px;
            margin: 0 5px;
            min-width: 70px;
            cursor: pointer;
